# ========================================
# 健康饮食积分系统 - 生产环境 Docker 配置
# 使用说明: 复制此文件为 .env.docker，然后填入真实值
# 安全提醒: .env.docker 请勿提交到 Git 仓库！
# ========================================

# ============================
# 数据库配置 (MySQL)
# ============================
MYSQL_ROOT_PASSWORD=YourStrongRootPassword123!
DB_NAME=health_system
DB_USER=db_user
DB_PASSWORD=YourStrongDbPassword456!

# ============================
# JWT 签名密钥 (必须替换为随机字符串)
# 生成方法: openssl rand -hex 32
# ============================
JWT_SECRET=replace_with_64_char_random_hex_string_here_xxxxxxxx

# ============================
# AES-256 加密密钥 (必须恰好 32 字节)
# 生成方法: openssl rand -hex 32
# ============================
AES_SECRET_KEY=replace_with_32_byte_hex_key_here_xxxxxxxxxxxxxxxxxx

# ============================
# 微信小程序配置
# 获取地址: https://mp.weixin.qq.com
# ============================
WX_APPID=wxfe26dc17bcb16161
WX_SECRET=replace_with_your_weixin_app_secret_here

# ============================
# CORS 配置（允许的前端域名）
# ============================
ALLOWED_ORIGINS=https://rry.klai.top,https://www.rry.klai.top

# ============================
# AI 服务配置
# 当前使用 SiliconFlow (硅基流动)
# ============================
AI_SERVICE_URL=https://api.siliconflow.cn/v1/chat/completions
AI_SERVICE_KEY=replace_with_your_siliconflow_api_key_here
AI_SERVICE_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 内容安全审核
CONTENT_SECURITY_URL=https://api.siliconflow.cn/v1/chat/completions
CONTENT_SECURITY_KEY=replace_with_your_siliconflow_api_key_here
CONTENT_SECURITY_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 文本生成任务
TEXT_SERVICE_URL=https://api.siliconflow.cn/v1/chat/completions
TEXT_SERVICE_KEY=replace_with_your_siliconflow_api_key_here
TEXT_SERVICE_MODEL=Qwen/Qwen3.5-4B

# ============================
# 对象存储配置（可选）
# 如果不需要 COS/OSS，可留空或使用本地存储
# ============================
OSS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
OSS_BUCKET=replace-with-your-bucket-name
OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
OSS_REGION=ap-guangzhou

# ============================
# 日志配置
# ============================
LOG_LEVEL=warn
LOG_FILE=logs/app.log

# ============================
# 定时任务控制
# ============================
ENABLE_SCHEDULER=true
