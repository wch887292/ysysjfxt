/* pages/service-provider/alerts/alerts.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* hover-class 点击反馈 */
.btn-hover {
  opacity: 0.7;
  transform: scale(0.98);
}

.card-hover {
  background-color: #f0f0f0;
  transform: scale(0.99);
}

/* 预警卡片列表 */
.alert-list {
  margin-top: 0;
}

.alert-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.alert-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.user-name {
  flex: 1;
  font-size: 24px;
  font-weight: bold;
  color: #333333;
  margin-right: 20rpx;
}

.alert-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 18px;
  white-space: nowrap;
  background-color: rgba(255, 152, 0, 0.15);
  color: #FF9800;
}

.alert-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.meta-item {
  font-size: 18px;
  color: #666666;
  margin-right: 20rpx;
}

.alert-action {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-follow {
  height: 48px;
  line-height: 48px;
  padding: 0 40rpx;
  background-color: #FF9800;
  color: #ffffff;
  border: none;
  font-size: 18px;
  border-radius: 8rpx;
}

/* 空状态 / 加载状态 */
.empty-state,
.loading-state,
.end-tip {
  text-align: center;
  padding: 60rpx 30rpx;
  font-size: 18px;
  color: #666666;
}

.empty-icon {
  font-size: 40px;
  display: block;
  margin-bottom: 15rpx;
}

/* 跟进表单弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 85%;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
  text-align: center;
}

.label {
  font-size: 18px;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 15rpx;
}

.textarea {
  width: 100%;
  height: 240rpx;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  box-sizing: border-box;
  background-color: #fafafa;
}

.modal-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}

.btn-cancel {
  flex: 1;
  height: 48px;
  line-height: 48px;
  background-color: #f5f5f5;
  color: #666666;
  border: none;
  font-size: 18px;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.btn-confirm {
  flex: 1;
  height: 48px;
  line-height: 48px;
  background-color: #4CAF50;
  color: #ffffff;
  border: none;
  font-size: 18px;
  border-radius: 8rpx;
}

.btn-confirm[disabled] {
  background-color: #a5d6a7;
  color: #ffffff;
}
