/* pages/service-provider/users/users.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.search-box {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 48px;
  line-height: 40px;
  padding: 0 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  margin-right: 20rpx;
}

.btn-search {
  height: 48px;
  line-height: 40px;
  padding: 0 30rpx;
  background-color: #4CAF50;
  color: white;
  border: none;
  font-size: 18px;
}

.btn-hover {
  opacity: 0.7;
}

.tab-bar {
  display: flex;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666;
}

.tab-active {
  color: #4CAF50;
  font-weight: bold;
  border-bottom: 4rpx solid #4CAF50;
}

.action-hover {
  background-color: #f0f0f0;
  transform: scale(0.95);
}

.user-list {
  margin-top: 20rpx;
}

.user-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: white;
  border-radius: 12rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* hover-class 点击反馈 */
.item-hover {
  background-color: #f0f0f0;
  transform: scale(0.98);
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 18px;
  color: #666;
}

.user-stats {
  text-align: right;
}

.user-points {
  font-size: 18px;
  font-weight: bold;
  color: #FF9800;
  display: block;
  margin-bottom: 8rpx;
}

.user-inactive {
  font-size: 18px;
  color: #F44336;
  display: block;
}

.user-active {
  font-size: 18px;
  color: #4CAF50;
  display: block;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #666666;
}
