/* pages/service-provider/home/home.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.stat-box {
  background-color: #f9f9f9;
  padding: 30rpx;
  border-radius: 12rpx;
  text-align: center;
}

.stat-value {
  font-size: 32px;
  font-weight: bold;
  color: #4CAF50;
  display: block;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666;
}

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 30rpx;
}

.action-item {
  width: 33.33%;
  text-align: center;
  padding: 30rpx 10rpx;
  box-sizing: border-box;
  margin-bottom: 15rpx;
  background-color: white;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* hover-class 点击反馈 */
.action-hover {
  background-color: #f0f0f0;
  transform: scale(0.95);
}

.action-icon {
  font-size: 40px;
  display: block;
  margin-bottom: 15rpx;
}

.action-text {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #333;
}

.inactive-list {
  margin-top: 20rpx;
}

.inactive-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.inactive-name {
  flex: 1;
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #333;
}

.inactive-days {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #FF9800;
}

.view-all {
  text-align: center;
  padding: 24rpx 0;
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #4CAF50;
}
