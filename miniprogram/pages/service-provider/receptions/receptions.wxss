/* pages/service-provider/receptions/receptions.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 操作栏 */
.action-bar {
  margin-bottom: 20rpx;
}

.btn-new {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #4CAF50;
  color: #ffffff;
  border: none;
  font-size: 18px;
  border-radius: 12rpx;
}

.btn-new[disabled] {
  background-color: #a5d6a7;
  color: #ffffff;
}

/* hover-class 点击反馈 */
.btn-hover {
  opacity: 0.7;
  transform: scale(0.98);
}

.card-hover {
  background-color: #f0f0f0;
  transform: scale(0.99);
}

/* 卡片 */
.card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.form-card {
  background-color: #ffffff;
}

.form-title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.label {
  font-size: 18px;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 15rpx;
}

.label.mt {
  margin-top: 30rpx;
}

.input {
  height: 48px;
  line-height: 44px;
  padding: 0 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  background-color: #fafafa;
}

.textarea {
  width: 100%;
  height: 240rpx;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  box-sizing: border-box;
  background-color: #fafafa;
}

.picker-box {
  height: 48px;
  line-height: 44px;
  padding: 0 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  background-color: #fafafa;
}

.picker-text {
  color: #333;
  font-size: 18px;
}

.picker-placeholder {
  color: #999;
  font-size: 18px;
}

.btn-submit {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #4CAF50;
  color: #ffffff;
  border: none;
  font-size: 18px;
  border-radius: 8rpx;
  margin-top: 30rpx;
}

.btn-submit[disabled] {
  background-color: #a5d6a7;
  color: #ffffff;
}

/* 接待记录列表 */
.reception-list {
  margin-top: 0;
}

.reception-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.reception-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.user-name {
  flex: 1;
  font-size: 24px;
  font-weight: bold;
  color: #333333;
  margin-right: 20rpx;
}

.result-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 18px;
  white-space: nowrap;
}

.result-pending {
  background-color: rgba(255, 152, 0, 0.15);
  color: #FF9800;
}

.result-converted {
  background-color: rgba(76, 175, 80, 0.15);
  color: #4CAF50;
}

.result-follow_up {
  background-color: rgba(33, 150, 243, 0.15);
  color: #2196F3;
}

.result-lost {
  background-color: rgba(158, 158, 158, 0.15);
  color: #9e9e9e;
}

.reception-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.meta-item {
  font-size: 18px;
  color: #666666;
  margin-right: 20rpx;
}

.reception-content {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: 18px;
  color: #555555;
  line-height: 1.6;
  margin-top: 16rpx;
  word-break: break-all;
}

/* 空状态 / 加载状态 */
.empty-state,
.loading-state,
.end-tip {
  text-align: center;
  padding: 60rpx 30rpx;
  font-size: 18px;
  color: #666666;
}

.empty-icon {
  font-size: 40px;
  display: block;
  margin-bottom: 15rpx;
}
