/* pages/service-provider/profile/profile.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 卡片 */
.card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.profile-card {
  padding-bottom: 30rpx;
}

.profile-header {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.profile-title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.badge-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.status-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 18px;
  white-space: nowrap;
  margin-right: 16rpx;
}

.status-active {
  background-color: rgba(76, 175, 80, 0.15);
  color: #4CAF50;
}

.status-pending {
  background-color: rgba(255, 152, 0, 0.15);
  color: #FF9800;
}

.status-inactive {
  background-color: rgba(158, 158, 158, 0.15);
  color: #9e9e9e;
}

.status-rejected {
  background-color: rgba(244, 67, 54, 0.15);
  color: #f44336;
}

.verify-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 18px;
  background-color: rgba(33, 150, 243, 0.15);
  color: #2196F3;
  white-space: nowrap;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-label {
  font-size: 18px;
  color: #666666;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.info-value {
  font-size: 18px;
  color: #333333;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

/* 编辑按钮 */
.btn-edit {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #4CAF50;
  color: #ffffff;
  border: none;
  font-size: 18px;
  border-radius: 8rpx;
  margin-top: 30rpx;
}

/* 表单 */
.form-card {
  background-color: #ffffff;
}

.form-title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.label {
  font-size: 18px;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 15rpx;
}

.label.mt {
  margin-top: 30rpx;
}

.input {
  height: 48px;
  line-height: 44px;
  padding: 0 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  background-color: #fafafa;
}

.textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  box-sizing: border-box;
  background-color: #fafafa;
}

.btn-submit {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #4CAF50;
  color: #ffffff;
  border: none;
  font-size: 18px;
  border-radius: 8rpx;
  margin-top: 30rpx;
}

.btn-submit[disabled] {
  background-color: #a5d6a7;
  color: #ffffff;
}

.btn-cancel {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #e0e0e0;
  color: #666666;
  border: none;
  font-size: 18px;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

/* hover-class 点击反馈 */
.btn-hover {
  opacity: 0.7;
  transform: scale(0.98);
}

/* 空状态 / 加载状态 */
.empty-state,
.loading-state {
  text-align: center;
  padding: 60rpx 30rpx;
  font-size: 18px;
  color: #666666;
}

.empty-icon {
  font-size: 40px;
  display: block;
  margin-bottom: 15rpx;
}
