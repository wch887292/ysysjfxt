/* pages/admin/dashboard/dashboard.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.metric-item {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 30rpx;
  border-radius: 12rpx;
  text-align: center;
}

.metric-value {
  font-size: 32px;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.metric-label {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  opacity: 0.9;
}

.activity-grid {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}

.activity-item {
  text-align: center;
  flex: 1;
  padding: 20rpx;
}

.activity-value {
  font-size: 28px;
  font-weight: bold;
  color: #4CAF50;
  display: block;
  margin-bottom: 10rpx;
}

.activity-label {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666;
}

.points-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-top: 20rpx;
  padding: 30rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.points-item {
  text-align: center;
  flex: 1;
}

.points-label {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.points-value {
  font-size: 36px;
  font-weight: bold;
  color: #FF9800;
}

.points-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: #ddd;
}

/* 管理菜单 */
.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 16rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.menu-hover {
  background-color: #e8f5e9;
  transform: scale(0.96);
}

.menu-icon {
  font-size: 32px;
  margin-bottom: 12rpx;
}

.menu-text {
  font-size: 18px;
  color: #333;
  text-align: center;
  line-height: 1.4;
}