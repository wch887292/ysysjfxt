/* pages/admin/posts-review/posts-review.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0;
  flex-wrap: wrap;
}

.filter-item {
  padding: 16rpx 32rpx;
  font-size: 18px;
  border-radius: 40rpx;
  background-color: #e0e0e0;
  color: #333;
  transition: all 0.2s;
}

.filter-active {
  background-color: #4CAF50;
  color: white;
}

.btn-hover {
  opacity: 0.7;
  transform: scale(0.98);
}

/* 列表 */
.list {
  margin-top: 20rpx;
}

.list-item {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.item-title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.item-tag {
  font-size: 18px;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  color: white;
  white-space: nowrap;
}

.status-pending {
  background-color: #FF9800;
}

.status-approved {
  background-color: #4CAF50;
}

.status-rejected {
  background-color: #F44336;
}

.item-info {
  margin-bottom: 16rpx;
}

.info-text {
  display: block;
  font-size: 18px;
  color: #666;
  line-height: 1.8;
}

.item-summary {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
}

.summary-text {
  font-size: 18px;
  color: #555;
  line-height: 1.8;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.item-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.item-reject-reason {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background-color: #fff3e0;
  border-radius: 8rpx;
  border-left: 6rpx solid #FF9800;
}

.reject-label {
  font-size: 18px;
  color: #e65100;
  font-weight: bold;
}

.reject-text {
  font-size: 18px;
  color: #bf360c;
  line-height: 1.8;
}

.item-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.btn-action {
  height: 48px;
  line-height: 48px;
  padding: 0 32rpx;
  font-size: 18px;
  border-radius: 8rpx;
}

.btn-approve {
  background-color: #f5f5f5;
  color: #4CAF50;
  border: 1rpx solid #4CAF50;
}

.btn-reject {
  background-color: #f5f5f5;
  color: #F44336;
  border: 1rpx solid #F44336;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background-color: white;
  border-radius: 16rpx;
  padding: 40rpx;
  width: 85%;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 18px;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.form-textarea {
  min-height: 200rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  line-height: 1.8;
  width: 100%;
  box-sizing: border-box;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 48px;
  line-height: 48px;
  font-size: 18px;
  border-radius: 8rpx;
  border: none;
}

.btn-primary {
  background-color: #F44336;
  color: white;
}

.btn-secondary {
  background-color: #e0e0e0;
  color: #333;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #666666;
  font-size: 18px;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #666;
  font-size: 18px;
}
