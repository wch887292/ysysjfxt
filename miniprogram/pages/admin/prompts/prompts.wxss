/* pages/admin/prompts/prompts.wxss - 适老化重写 */
.container { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.subtitle { font-size: 24px; font-weight: bold; color: #333; display: block; margin-bottom: 20rpx; }
.flex-between { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.btn-add { height: 96rpx; line-height: 96rpx; padding: 0 32rpx; font-size: 18px; background: #4CAF50; color: #fff; border-radius: 12rpx; border: none; }
.list { }
.list-item { padding: 24rpx 0; border-bottom: 2rpx solid #f0f0f0; }
.list-item:last-child { border-bottom: none; }
.item-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.item-name { font-size: 24px; font-weight: bold; color: #333; }
.item-tag { font-size: 18px; padding: 4rpx 16rpx; border-radius: 8rpx; }
.tag-active { background: #E8F5E9; color: #2E7D32; }
.tag-draft { background: #FFF3E0; color: #E65100; }
.tag-archived { background: #F5F5F5; color: #9E9E9E; }
.item-info { display: flex; flex-direction: column; gap: 8rpx; }
.info-text { font-size: 18px; color: #666666; line-height: 1.8; }
.item-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.btn-action { height: 96rpx; line-height: 96rpx; padding: 0 24rpx; font-size: 18px; background: #f5f5f5; color: #333; border-radius: 8rpx; border: none; }
.btn-primary { background: #4CAF50; color: #fff; }
.empty-state { text-align: center; padding: 80rpx 0; color: #666666; font-size: 18px; }
.loading { text-align: center; padding: 40rpx 0; color: #666666; font-size: 18px; }

/* 弹窗样式 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal-content { background: #fff; border-radius: 16rpx; padding: 32rpx; width: 90%; max-height: 80vh; overflow-y: auto; }
.modal-title { font-size: 24px; font-weight: bold; color: #333; display: block; margin-bottom: 24rpx; text-align: center; }
.form-group { margin-bottom: 20rpx; }
.form-label { font-size: 18px; color: #333; display: block; margin-bottom: 8rpx; }
.form-input { height: 96rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 0 20rpx; font-size: 18px; color: #333; }
.form-textarea { border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 18px; color: #333; min-height: 200rpx; width: 100%; box-sizing: border-box; line-height: 1.8; }
.picker-value { line-height: 96rpx; }
.btn-group { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn { flex: 1; height: 96rpx; line-height: 96rpx; font-size: 18px; border-radius: 12rpx; border: none; text-align: center; }
.btn-primary { background: #4CAF50; color: #fff; }
.btn-secondary { background: #f5f5f5; color: #666666; }
.detail-info { display: flex; flex-direction: column; gap: 12rpx; }
.content-box { background: #f9f9f9; border-radius: 12rpx; padding: 20rpx; margin-top: 16rpx; }
.content-text { font-size: 18px; color: #555; line-height: 1.8; word-break: break-all; }
