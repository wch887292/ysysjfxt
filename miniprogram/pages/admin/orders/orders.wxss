/* pages/admin/orders/orders.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.search-box {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 48px;
  line-height: 40px;
  padding: 0 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  margin-right: 20rpx;
}

.btn-search {
  height: 48px;
  line-height: 40px;
  padding: 0 30rpx;
  background-color: #4CAF50;
  color: white;
  border: none;
  font-size: 18px;
}

.btn-hover {
  opacity: 0.7;
  transform: scale(0.98);
}

.list {
  margin-top: 20rpx;
}

.list-item {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.item-order-no {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  font-family: 'Courier New', monospace;
}

.item-tag {
  font-size: 18px;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  color: white;
}

.status-pending {
  background-color: #FF9800;
}

.status-paid {
  background-color: #4CAF50;
}

.status-completed {
  background-color: #2196F3;
}

.status-refunded {
  background-color: #9E9E9E;
}

.item-info {
  margin-bottom: 16rpx;
}

.info-text {
  display: block;
  font-size: 18px;
  color: #666;
  line-height: 1.8;
}

.item-actions {
  display: flex;
  gap: 16rpx;
}

.btn-action {
  height: 48px;
  line-height: 48px;
  padding: 0 24rpx;
  font-size: 18px;
  background-color: #f5f5f5;
  color: #4CAF50;
  border: 1rpx solid #4CAF50;
  border-radius: 8rpx;
}

.btn-danger {
  color: #F44336;
  border-color: #F44336;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #666;
}
