/* pages/agent/write-off/write-off.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.card {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  display: block;
}

.subtitle {
  font-size: 18px;
  color: #666666;
  display: block;
  margin-top: 10rpx;
}

.label {
  font-size: 18px;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 15rpx;
}

.label.mt {
  margin-top: 30rpx;
}

.picker-box {
  height: 48px;
  line-height: 44px;
  padding: 0 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  background-color: #fafafa;
}

.picker-text {
  font-size: 18px;
  color: #333;
}

.picker-placeholder {
  font-size: 18px;
  color: #666666;
}

.user-points {
  margin-top: 15rpx;
  font-size: 18px;
  color: #666;
}

.points-num {
  font-size: 18px;
  font-weight: bold;
  color: #FF9800;
}

.input {
  height: 48px;
  line-height: 44px;
  padding: 0 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
}

.textarea {
  width: 100%;
  height: 120rpx;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  box-sizing: border-box;
}

.result-card {
  background-color: #f1f8f2;
  border: 1rpx solid #c8e6c9;
}

.result-title {
  font-size: 18px;
  font-weight: bold;
  color: #2e7d32;
  display: block;
  margin-bottom: 20rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e0f0e1;
}

.result-key {
  font-size: 18px;
  color: #555;
}

.result-num {
  font-size: 18px;
  font-weight: bold;
  color: #4CAF50;
}

.result-val {
  font-size: 18px;
  color: #333;
}

.actions {
  display: flex;
  margin-top: 10rpx;
}

.btn-reset {
  flex: 1;
  margin-right: 20rpx;
  height: 48px;
  line-height: 48px;
  background-color: #eeeeee;
  color: #555;
  border: none;
  font-size: 18px;
  border-radius: 8rpx;
}

.btn-submit {
  flex: 2;
  height: 48px;
  line-height: 48px;
  background-color: #4CAF50;
  color: white;
  border: none;
  font-size: 18px;
  border-radius: 8rpx;
}

.btn-submit[disabled] {
  background-color: #a5d6a7;
  color: #fff;
}

.tip {
  font-size: 18px;
  color: #666666;
  padding: 20rpx;
  line-height: 1.8;
}
