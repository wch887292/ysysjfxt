/* pages/agent/posts/posts.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 发布按钮 */
.publish-bar {
  margin-bottom: 20rpx;
}

.btn-publish {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #4CAF50;
  color: #ffffff;
  border: none;
  font-size: 18px;
  border-radius: 12rpx;
}

.btn-publish[disabled] {
  background-color: #a5d6a7;
  color: #ffffff;
}

/* hover-class 点击反馈 */
.btn-hover {
  opacity: 0.7;
  transform: scale(0.98);
}

.card-hover {
  background-color: #f0f0f0;
  transform: scale(0.99);
}

.tab-hover {
  background-color: #f0f0f0;
}

/* 卡片 */
.card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 表单 */
.form-card {
  background-color: #ffffff;
}

.form-title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.label {
  font-size: 18px;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 15rpx;
}

.label.mt {
  margin-top: 30rpx;
}

.input {
  height: 48px;
  line-height: 44px;
  padding: 0 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  background-color: #fafafa;
}

.textarea {
  width: 100%;
  height: 240rpx;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 18px;
  box-sizing: border-box;
  background-color: #fafafa;
}

.btn-submit {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #4CAF50;
  color: #ffffff;
  border: none;
  font-size: 18px;
  border-radius: 8rpx;
  margin-top: 30rpx;
}

.btn-submit[disabled] {
  background-color: #a5d6a7;
  color: #ffffff;
}

/* 状态筛选 Tab */
.tab-bar {
  display: flex;
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 18px;
  color: #666666;
  min-height: 96rpx;
  box-sizing: border-box;
}

.tab-active {
  color: #4CAF50;
  font-weight: bold;
  border-bottom: 6rpx solid #4CAF50;
}

/* 信息列表 */
.post-list {
  margin-top: 0;
}

.post-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.post-title {
  flex: 1;
  font-size: 24px;
  font-weight: bold;
  color: #333333;
  margin-right: 20rpx;
}

.status-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 18px;
  white-space: nowrap;
}

.status-pending_review {
  background-color: rgba(255, 152, 0, 0.15);
  color: #FF9800;
}

.status-approved {
  background-color: rgba(76, 175, 80, 0.15);
  color: #4CAF50;
}

.status-rejected {
  background-color: rgba(244, 67, 54, 0.15);
  color: #f44336;
}

.post-content {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: 18px;
  color: #555555;
  line-height: 1.6;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.post-company {
  font-size: 18px;
  color: #4CAF50;
  margin-right: 20rpx;
}

.post-time {
  font-size: 18px;
  color: #666666;
}

.reject-box {
  margin-top: 16rpx;
  padding: 20rpx;
  background-color: rgba(244, 67, 54, 0.08);
  border-left: 6rpx solid #f44336;
  border-radius: 8rpx;
}

.reject-label {
  font-size: 18px;
  color: #f44336;
  font-weight: bold;
}

.reject-reason {
  font-size: 18px;
  color: #d32f2f;
  display: block;
  margin-top: 8rpx;
}

/* 空状态 / 加载状态 */
.empty-state,
.loading-state,
.end-tip {
  text-align: center;
  padding: 60rpx 30rpx;
  font-size: 18px;
  color: #666666;
}

.empty-icon {
  font-size: 40px;
  display: block;
  margin-bottom: 15rpx;
}
