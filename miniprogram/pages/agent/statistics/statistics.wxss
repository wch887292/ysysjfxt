/* pages/agent/statistics/statistics.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.stat-box {
  background-color: #f9f9f9;
  padding: 30rpx;
  border-radius: 12rpx;
  text-align: center;
}

.stat-value {
  font-size: 32px;
  font-weight: bold;
  color: #4CAF50;
  display: block;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666;
}

.rate-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.rate-bar {
  flex: 1;
  height: 20rpx;
  background-color: #eee;
  border-radius: 10rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

.rate-fill {
  height: 100%;
  background-color: #4CAF50;
  border-radius: 10rpx;
  transition: width 0.4s ease;
}

.rate-text {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  font-weight: bold;
  color: #4CAF50;
}

.rate-tip {
  display: block;
  margin-top: 15rpx;
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666666;
}

.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #666666;
  font-size: 18px; /* 12.2 适老化最小字体18px */
}
