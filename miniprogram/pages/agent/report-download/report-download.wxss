/* pages/agent/report-download/report-download.wxss */
.container {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 用户信息 */
.user-info {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.user-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
}

/* 报告卡片 */
.report-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.report-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  margin-right: 16rpx;
}

.report-type {
  font-size: 36rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.type-crisis_hook {
  background: #FFF3E0;
  color: #FF9800;
}

.type-7day_plan {
  background: #E8F5E9;
  color: #4CAF50;
}

.report-meta {
  margin-bottom: 24rpx;
}

.report-date {
  font-size: 36rpx;
  color: #666666;
}

/* 下载按钮 - 适老化：最小48px高 */
.btn-download {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 40rpx;
  background: #4CAF50;
  color: #ffffff;
  border-radius: 16rpx;
  margin: 0;
  border: none;
}

.btn-download-hover {
  background: #388E3C;
  transform: scale(0.98);
}

.btn-download[disabled] {
  background: #A5D6A7;
  color: #ffffff;
}

/* 空状态与加载 */
.empty-tip,
.loading-tip {
  text-align: center;
  padding: 64rpx;
  font-size: 36rpx;
  color: #666666;
}

/* 点击反馈 */
.card-hover {
  background-color: #fafafa;
  transform: scale(0.98);
}
