/* pages/agent/review/review.wxss */
.container {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.tab-bar {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 36rpx;
  color: #666666;
  min-height: 96rpx;
  box-sizing: border-box;
}

.tab-active {
  color: #4CAF50;
  font-weight: bold;
  border-bottom: 6rpx solid #4CAF50;
}

.meal-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.meal-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.meal-user {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
}

.meal-type {
  font-size: 36rpx;
  color: #4CAF50;
}

.meal-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.meal-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.meal-ai {
  font-size: 36rpx;
  color: #666666;
}

.meal-points {
  font-size: 36rpx;
  color: #FF9800;
  font-weight: bold;
}

.meal-actions {
  display: flex;
  gap: 24rpx;
}

.btn-approve,
.btn-reject {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 40rpx;
  border-radius: 16rpx;
  margin: 0;
}

.btn-approve {
  background: #4CAF50;
  color: #ffffff;
}

.btn-reject {
  background: #ffffff;
  color: #F44336;
  border: 1rpx solid #F44336;
}

.empty-tip,
.loading-tip {
  text-align: center;
  padding: 64rpx;
  font-size: 36rpx;
  color: #666666;
}

/* P1修复：hover-class 点击反馈 */
.tab-hover {
  background-color: #f0f0f0;
}

.card-hover {
  background-color: #fafafa;
  transform: scale(0.98);
}
