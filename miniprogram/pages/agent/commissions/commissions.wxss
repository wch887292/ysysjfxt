/* pages/agent/commissions/commissions.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 汇总卡片 */
.summary-row {
  display: flex;
  margin-bottom: 20rpx;
}

.summary-card {
  flex: 1;
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx 10rpx;
  margin-right: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.summary-card:last-child {
  margin-right: 0;
}

.summary-label {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.summary-amount {
  font-size: 20px;
  font-weight: bold;
  color: #4CAF50;
  display: block;
  word-break: break-all;
}

/* 状态筛选 Tab */
.tab-bar {
  display: flex;
  background-color: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666;
  min-height: 48px; /* 12.2 适老化按钮高度>=48px */
  box-sizing: border-box;
}

.tab-active {
  color: #4CAF50;
  font-weight: bold;
  border-bottom: 6rpx solid #4CAF50;
}

.tab-hover {
  background-color: #f0f0f0;
}

/* 分润列表 */
.commission-item {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.item-hover {
  background-color: #f0f0f0;
  transform: scale(0.98);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-source {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  font-weight: bold;
  color: #333;
}

.status-badge {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

.status-pending {
  background-color: #FFF3E0;
  color: #FF9800;
}

.status-settled {
  background-color: #E8F5E9;
  color: #4CAF50;
}

.status-cancelled {
  background-color: #F5F5F5;
  color: #666666;
}

.item-user {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-name {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #333;
  margin-right: 20rpx;
}

.item-phone {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666666;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-period {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666;
}

.item-amount {
  font-size: 22px;
  font-weight: bold;
  color: #4CAF50;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 48px;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 18px; /* 12.2 适老化最小字体18px */
  color: #666;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #666;
  font-size: 18px; /* 12.2 适老化最小字体18px */
}

.bottom-tip {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 18px; /* 12.2 适老化最小字体18px */
}
