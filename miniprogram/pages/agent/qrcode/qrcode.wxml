<view class="container">
  <!-- 标题和说明 -->
  <view class="header">
    <text class="title">拉新二维码</text>
    <text class="desc">分享您的专属二维码，邀请更多用户加入</text>
  </view>

  <!-- 二维码展示区域 -->
  <view class="qr-section">
    <view class="qr-wrapper" wx:if="{{!loading}}">
      <image class="qr-image" wx:if="{{qrImageUrl}}" src="{{qrImageUrl}}" mode="aspectFit" show-menu-by-longpress="{{true}}"></image>
      <view class="qr-empty" wx:else>
        <text>二维码生成中，请稍候</text>
      </view>
    </view>
    <view class="qr-loading" wx:else>
      <text>加载中...</text>
    </view>
  </view>

  <!-- 分享码显示 -->
  <view class="share-code-section" wx:if="{{shareCode}}">
    <text class="share-code-label">专属分享码</text>
    <text class="share-code-value">{{shareCode}}</text>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-save" hover-class="btn-hover" bindtap="saveToAlbum">保存到相册</button>
    <button class="btn-share" hover-class="btn-hover" open-type="share">分享给好友</button>
  </view>
</view>
