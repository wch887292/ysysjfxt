/* pages/agent/report-edit/report-edit.wxss */
/* 适老化规范：最小字体18px(36rpx)，标题24px+(48rpx+)，行间距1.8倍，按钮高度48px+(96rpx+)，对比度≥4.5:1 */

.container {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* 用户信息栏 */
.user-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.user-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.8;
}

.user-label {
  font-size: 36rpx;
  color: #4CAF50;
}

/* 报告列表 */
.report-list {
  margin-bottom: 32rpx;
}

.report-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid transparent;
  transition: all 0.2s;
}

.report-active {
  border-left-color: #4CAF50;
  background: #f1f8f1;
}

.report-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.8;
}

.report-date {
  font-size: 36rpx;
  color: #999999;
  margin-top: 8rpx;
  line-height: 1.8;
}

.report-hover {
  background-color: #fafafa;
  transform: scale(0.98);
}

/* 编辑区域 */
.editor-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.editor-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.editor-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.8;
}

.change-hint {
  font-size: 36rpx;
  color: #FF9800;
  margin-left: 12rpx;
}

.editor-area {
  width: 100%;
  min-height: 400rpx;
  font-size: 36rpx;
  color: #333333;
  line-height: 1.8;
  padding: 24rpx;
  box-sizing: border-box;
  background: #fafafa;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
}

/* 违禁词警告 */
.warning-bar {
  display: flex;
  align-items: flex-start;
  background: #FFF3E0;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #FF9800;
}

.warning-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
  line-height: 1.8;
}

.warning-text {
  font-size: 36rpx;
  color: #E65100;
  line-height: 1.8;
  flex: 1;
}

/* 底部保存按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.btn-save {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 40rpx;
  border-radius: 16rpx;
  background: #4CAF50;
  color: #ffffff;
  text-align: center;
  margin: 0;
  padding: 0;
  border: none;
}

.btn-save[disabled] {
  background: #c8c8c8;
  color: #ffffff;
}

.btn-save-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 空状态 & 加载中 */
.empty-tip,
.loading-tip {
  text-align: center;
  padding: 64rpx;
  font-size: 36rpx;
  color: #666666;
  line-height: 1.8;
}
