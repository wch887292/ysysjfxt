/* pages/agent/convert-member/convert-member.wxss */
.container {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.user-detail {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow: hidden;
}

.user-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-role {
  font-size: 36rpx;
  color: #4CAF50;
}

.user-date {
  font-size: 36rpx;
  color: #666666;
}

/* 会员权益说明 */
.benefits-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 24rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.benefit-icon {
  font-size: 36rpx;
  color: #4CAF50;
  margin-right: 16rpx;
  font-weight: bold;
}

.benefit-text {
  font-size: 36rpx;
  color: #333333;
}

/* 转化成功状态 */
.success-section {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
}

.success-icon {
  font-size: 80rpx;
  color: #4CAF50;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.success-text {
  font-size: 36rpx;
  color: #4CAF50;
  font-weight: bold;
}

/* 转化按钮 */
.btn-convert {
  width: 100%;
  height: 112rpx;
  line-height: 112rpx;
  font-size: 40rpx;
  border-radius: 16rpx;
  background: #4CAF50;
  color: #ffffff;
  text-align: center;
  margin: 0;
  border: none;
}

.btn-convert[disabled] {
  background: #cccccc;
  color: #ffffff;
}

.btn-convert-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 空状态与加载 */
.empty-tip,
.loading-tip {
  text-align: center;
  padding: 128rpx 32rpx;
  font-size: 36rpx;
  color: #666666;
}
