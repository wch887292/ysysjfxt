/* pages/user/statistics/statistics.wxss */
.container {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.summary-card {
  display: flex;
  flex-wrap: wrap;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 0;
}

.summary-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.summary-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #4CAF50;
  line-height: 1.8;
}

.summary-label {
  font-size: 36rpx;
  color: #333333;
}

.section-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  margin: 40rpx 0 24rpx;
  line-height: 1.8;
}

.record-list {
  background: #ffffff;
  border-radius: 16rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #eeeeee;
  min-height: 96rpx;
  box-sizing: border-box;
}

.record-left {
  display: flex;
  flex-direction: column;
}

.record-meal {
  font-size: 36rpx;
  color: #333333;
  line-height: 1.8;
}

.record-date {
  font-size: 36rpx;
  color: #666666;
}

.record-points {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF9800;
}

.empty-tip,
.loading-tip,
.no-more-tip {
  text-align: center;
  padding: 48rpx;
  font-size: 36rpx;
  color: #666666;
}
