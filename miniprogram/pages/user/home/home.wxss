/* pages/user/home/home.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.user-card {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  color: white;
  margin-bottom: 30rpx;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid white;
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 24px;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.user-level {
  font-size: 18px;
  opacity: 0.9;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx 0;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 28px;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 18px;
  opacity: 0.9;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.quick-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.action-item {
  flex: 1;
  background-color: white;
  padding: 40rpx 20rpx;
  margin: 0 8rpx;
  border-radius: 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.action-icon {
  font-size: 40px;
  display: block;
  margin-bottom: 15rpx;
}

.action-text {
  font-size: 18px;
  color: #333;
}

.meal-list {
  margin-top: 20rpx;
}

.meal-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 点击反馈（规格12.2 适老化：明确交互反馈） */
.meal-item-hover {
  background-color: #f5f5f5;
}

/* 卡片头部：标题 + 查看全部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.view-all {
  font-size: 18px;
  color: #1976D2;
  padding: 10rpx 0;
}

/* 空状态上传按钮 */
.empty-upload-btn {
  margin-top: 20rpx;
  width: 60%;
}

.meal-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.meal-info {
  flex: 1;
}

.meal-type {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.meal-points {
  font-size: 18px;
  color: #FF9800;
  display: block;
  margin-bottom: 5rpx;
}

.meal-time {
  font-size: 18px;
  color: #666666; /* 7.1.3 对比度修复 */
}
/* 登录界面 */
.login-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-top: 100rpx;
}
.login-logo {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}
.login-title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.login-desc {
  font-size: 18px;
  color: #666666; /* 7.1.3 对比度修复 */
  margin-bottom: 60rpx;
}
.login-btn {
  background: #4CAF50;
  color: #fff;
  font-size: 18px;
  height: 96rpx; /* 12.2 按钮高度≥48px (96rpx=48px) */
  line-height: 96rpx;
  border-radius: 48rpx;
}

.action-hover {
  opacity: 0.8;
  transform: scale(0.96);
}

/* 区块标题 */
.section-title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  margin: 20rpx 8rpx 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #4CAF50;
}

/* 核心功能九宫格 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  background: white;
  border-radius: 12rpx;
  padding: 20rpx 10rpx;
  margin-bottom: 20rpx;
}

.feature-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  box-sizing: border-box;
}

.feature-item:active {
  background-color: #f5f5f5;
}

.feature-hover {
  opacity: 0.8;
  transform: scale(0.96);
}

.feature-icon {
  font-size: 48px;
  margin-bottom: 12rpx;
}

.feature-text {
  font-size: 18px;
  color: #333;
}

