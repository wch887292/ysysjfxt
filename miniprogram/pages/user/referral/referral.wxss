/* pages/user/referral/referral.wxss */
.container {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
  line-height: 1.8;
}

/* 统计卡 - 渐变背景 */
.stats-card {
  display: flex;
  background: linear-gradient(135deg, #4CAF50 0%, #8BC34A 100%);
  border-radius: 16rpx;
  padding: 36rpx 0;
  margin-bottom: 32rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.8;
}

.stats-label {
  font-size: 36rpx;
  color: #ffffff;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 分享卡 - 绿色边框 */
.share-card {
  background: #ffffff;
  border: 2rpx solid #4CAF50;
  border-radius: 16rpx;
  padding: 36rpx;
  margin-bottom: 32rpx;
}

.share-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.share-content {
  font-size: 36rpx;
  color: #4CAF50;
  background: #f1f8e9;
  border-radius: 12rpx;
  padding: 24rpx;
  word-break: break-all;
  line-height: 1.8;
}

.share-tip {
  font-size: 36rpx;
  color: #666666;
  margin-top: 16rpx;
  line-height: 1.8;
}

.share-actions {
  display: flex;
  margin-top: 28rpx;
}

.share-btn {
  flex: 1;
  font-size: 36rpx;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  line-height: 1.8;
  min-height: 96rpx;
  box-sizing: border-box;
}

.share-btn::after {
  border: none;
}

.copy-btn {
  background: #f1f8e9;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
  margin-right: 32rpx;
}

.friend-btn {
  background: #4CAF50;
  color: #ffffff;
}

/* 点击反馈 */
.share-btn-hover {
  opacity: 0.8;
  transform: scale(0.96);
}

/* 列表区 */
.section-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  margin: 16rpx 0 24rpx;
  line-height: 1.8;
}

.referral-list {
  background: #ffffff;
  border-radius: 16rpx;
}

.referral-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #eeeeee;
  min-height: 96rpx;
  box-sizing: border-box;
}

.referral-item:last-child {
  border-bottom: none;
}

.referral-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.referral-name {
  font-size: 36rpx;
  color: #333333;
  line-height: 1.8;
}

.referral-time {
  font-size: 36rpx;
  color: #666666;
  margin-top: 8rpx;
}

.referral-status {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
}

.status-done {
  background: #e8f5e9;
  color: #4CAF50;
}

.status-pending {
  background: #fff3e0;
  color: #FF9800;
}

.status-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.status-text {
  font-size: 36rpx;
}

.empty-tip,
.loading-tip,
.no-more-tip {
  text-align: center;
  padding: 48rpx;
  font-size: 36rpx;
  color: #666666;
}
