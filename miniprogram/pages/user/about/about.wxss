/* pages/user/about/about.wxss */
.container {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 48rpx;
}

.logo {
  font-size: 128rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.8;
  text-align: center;
}

.app-version {
  font-size: 36rpx;
  color: #666666;
}

.content-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
}

.doc-h2 {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
  line-height: 1.8;
}

.doc-p {
  display: block;
  font-size: 36rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.disclaimer {
  padding: 32rpx;
  font-size: 32rpx;
  color: #666666;
  line-height: 1.8;
  text-align: center;
}
