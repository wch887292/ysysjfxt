/* pages/user/privacy/privacy.wxss */
.container {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.content-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
}

.doc-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.8;
}

.doc-section {
  margin-bottom: 40rpx;
}

.doc-h2 {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
  line-height: 1.8;
}

.doc-p {
  display: block;
  font-size: 36rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

/* 数据权利操作区（规格7.4） */
.data-actions {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 36rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.export-btn {
  background: #4CAF50;
  color: #ffffff;
}

.delete-btn {
  background: #ffffff;
  color: #F44336;
  border: 1rpx solid #F44336;
}

.action-tip {
  font-size: 36rpx;
  color: #666;
  line-height: 1.8;
  text-align: center;
  padding: 16rpx 0;
}

/* 规格7.4：信息可见范围设置 */
.visibility-list {
  margin-top: 24rpx;
}

.visibility-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 48px;
}

.visibility-item:last-child {
  border-bottom: none;
}

.item-hover {
  background-color: #fafafa;
}

.visibility-info {
  flex: 1;
  margin-right: 24rpx;
}

.visibility-title {
  display: block;
  font-size: 18px;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.visibility-desc {
  display: block;
  font-size: 18px;
  color: #666666;
  line-height: 1.8;
}

.save-tip {
  font-size: 18px;
  color: #4CAF50;
  text-align: center;
  padding: 16rpx 0;
  margin-top: 8rpx;
}
