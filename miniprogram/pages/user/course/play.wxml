<!--pages/user/course/play.wxml-->
<view class="container">
  <block wx:if="{{loading}}">
    <view class="loading-tip">加载中...</view>
  </block>

  <block wx:elif="{{course}}">
    <view class="card header-card">
      <image class="cover-image" src="{{course.coverImage}}" mode="aspectFill"></image>
      <text class="course-title">{{course.title}}</text>
      <text class="course-duration">阅读时长：{{course.duration}}</text>
    </view>

    <view class="card content-card">
      <text class="section-title">课程内容</text>
      <scroll-view scroll-y class="content-scroll">
        <rich-text nodes="{{contentHtml}}"></rich-text>
      </scroll-view>
    </view>

    <view class="card">
      <text class="section-title">学习进度</text>
      <view class="progress-row">
        <view class="progress-bar">
          <view class="progress-inner" style="--progress: {{progress}}%"></view>
        </view>
        <text class="progress-text">{{progress}}%</text>
      </view>
      <view wx:if="{{progress >= 80}}" class="reward-tip">已获得10积分</view>
    </view>

    <view class="card action-card">
      <button class="btn btn-primary" bindtap="finishCourse" disabled="{{updating || progress >= 100}}">
        {{progress >= 100 ? '已完成阅读' : '标记为已读完'}}
      </button>
    </view>
  </block>

  <block wx:else>
    <view class="empty-tip">课程不存在</view>
  </block>
</view>