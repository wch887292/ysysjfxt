/* pages/user/course/play.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.card {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.loading-tip,
.empty-tip {
  text-align: center;
  font-size: 18px;
  color: #666;
  padding: 60rpx 0;
}

.header-card {
  padding: 0;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 360rpx;
  display: block;
  background-color: #f0f0f0;
}

.course-title {
  display: block;
  font-size: 24px;
  font-weight: bold;
  color: #333;
  padding: 20rpx 30rpx 0;
  line-height: 1.8;
}

.course-duration {
  display: block;
  font-size: 18px;
  color: #666;
  padding: 8rpx 30rpx 20rpx;
}

.content-card {
  min-height: 300rpx;
}

.content-scroll {
  max-height: 800rpx;
}

.section-title {
  display: block;
  font-size: 20px;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 24rpx;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-inner {
  height: 100%;
  width: var(--progress, 0%);
  background-color: #4CAF50;
  border-radius: 12rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 20px;
  color: #4CAF50;
  font-weight: bold;
  min-width: 90rpx;
  text-align: right;
}

.reward-tip {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #fff9e6;
  border-radius: 8rpx;
  font-size: 20px;
  color: #FF9800;
  font-weight: bold;
  text-align: center;
}

.action-card {
  padding: 20rpx 30rpx;
}

.btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 12rpx;
  font-size: 20px;
  font-weight: 500;
  text-align: center;
  padding: 0;
  margin: 0;
}

.btn-primary {
  background-color: #4CAF50;
  color: white;
}

.btn[disabled] {
  opacity: 0.6;
}