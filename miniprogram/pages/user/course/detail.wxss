/* pages/user/course/detail.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.card {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.loading-tip,
.empty-tip {
  text-align: center;
  font-size: 18px;
  color: #666;
  padding: 60rpx 0;
}

.cover-image {
  width: 100%;
  height: 360rpx;
  border-radius: 8rpx;
  background-color: #f0f0f0;
  margin-bottom: 20rpx;
}

.course-title {
  display: block;
  font-size: 24px;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.course-meta {
  display: flex;
  align-items: center;
}

.meta-item {
  font-size: 18px;
  color: #666;
}

.section-title {
  display: block;
  font-size: 20px;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.course-desc {
  display: block;
  font-size: 18px;
  color: #666;
  line-height: 1.8;
}

.progress-row {
  display: flex;
  align-items: center;
}

.progress-bar {
  flex: 1;
  height: 20rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-inner {
  height: 100%;
  width: var(--progress, 0%);
  background-color: #4CAF50;
  border-radius: 10rpx;
}

.progress-text {
  font-size: 18px;
  color: #4CAF50;
  font-weight: bold;
  min-width: 80rpx;
  text-align: right;
}

.reward-tip {
  margin-top: 16rpx;
  padding: 16rpx;
  background-color: #fff9e6;
  border-radius: 8rpx;
  font-size: 18px;
  color: #FF9800;
  font-weight: bold;
  text-align: center;
}

.action-area {
  margin-bottom: 20rpx;
}

.btn {
  display: block;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 12rpx;
  font-size: 20px;
  font-weight: 500;
  text-align: center;
}

.btn-primary {
  background-color: #4CAF50;
  color: white;
}

.history-link {
  text-align: center;
  font-size: 18px;
  color: #4CAF50;
  margin-top: 20rpx;
  padding: 20rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-date {
  font-size: 18px;
  color: #333;
}

.history-progress {
  font-size: 18px;
  color: #4CAF50;
  font-weight: bold;
}
