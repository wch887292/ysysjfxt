/* pages/user/exchange/exchange.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 积分卡片 */
.points-card {
  background: linear-gradient(135deg, #FF9800 0%, #FFC107 100%);
  color: #fff;
  text-align: center;
  padding: 50rpx 40rpx;
}

.points-label {
  font-size: 18px;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.points-value {
  font-size: 48px;
  font-weight: bold;
  line-height: 1.8;
}

/* 礼品卡片 */
.gifts-card {
  padding: 30rpx 20rpx;
}

.subtitle {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

/* 分类筛选 */
.category-bar {
  white-space: nowrap;
  padding: 10rpx 0 20rpx;
}

.cat-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 18px;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  min-width: 44px;
  text-align: center;
}

.cat-item.active {
  background-color: #FF9800;
  color: #fff;
}

/* 礼品列表 */
.gifts-list {
  margin-top: 10rpx;
}

.gift-item {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #f0f0f0;
}

.gift-image-wrap {
  position: relative;
  margin-right: 24rpx;
}

.gift-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  display: block;
}

.gift-cat-tag {
  position: absolute;
  left: 0;
  top: 0;
  padding: 4rpx 12rpx;
  font-size: 18px;
  color: #fff;
  background-color: rgba(0, 0, 0, 0.5);
  border-top-left-radius: 12rpx;
  border-bottom-right-radius: 12rpx;
}

.gift-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.gift-name {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.gift-description {
  font-size: 18px;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.gift-stock {
  font-size: 18px;
  color: #666666; /* 7.1.3 对比度修复：#999→#666 */
  margin-bottom: 8rpx;
}

.gift-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.gift-points {
  font-size: 24px;
  font-weight: bold;
  color: #FF9800;
}

.btn-exchange {
  min-width: 88rpx;
  min-height: 96rpx;
  padding: 0 28rpx;
  font-size: 18px;
  color: #fff;
  background-color: #FF9800;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-exchange.disabled {
  background-color: #ccc;
  color: #666;
}

.btn-hover {
  opacity: 0.8;
  transform: scale(0.96);
}

/* 兑换历史入口 */
.history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.history-entry-text {
  font-size: 24px;
  font-weight: bold;
  color: #333;
}

.history-entry-arrow {
  font-size: 24px;
  color: #666666; /* 7.1.3 对比度修复 */
}

/* 状态提示 */
.state-tip {
  text-align: center;
  padding: 80rpx 20rpx;
  color: #666666; /* 7.1.3 对比度修复 */
  font-size: 18px;
}

.state-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}
