/* pages/user/articles/articles.wxss */
.container { padding: 24rpx; background: #f5f5f5; min-height: 100vh; }

/* 分类标签 */
.category-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}
.tab-item {
  font-size: 18px;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666666;
  line-height: 1.6;
}
.tab-item.active {
  background: #4CAF50;
  color: #fff;
}

/* 资讯卡片 */
.article-list { }
.article-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.article-card-hover { opacity: 0.85; }

.article-cover {
  width: 100%;
  height: 320rpx;
}

.article-body {
  padding: 24rpx;
}
.article-title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.article-summary {
  font-size: 18px;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.article-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 18px;
  color: #999;
}
.meta-tag {
  background: #E8F5E9;
  color: #4CAF50;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 18px;
}
.meta-date {
  font-size: 18px;
  color: #999;
}
.meta-views {
  font-size: 18px;
  color: #999;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  padding: 32rpx 0;
  color: #999;
  font-size: 18px;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 18px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-icon {
  font-size: 48px;
}
