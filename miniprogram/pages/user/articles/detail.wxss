/* pages/user/articles/detail.wxss */
.container { background: #fff; min-height: 100vh; }

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 18px;
}

.cover-image {
  width: 100%;
  height: 400rpx;
}

.article-header {
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.article-title {
  font-size: 28px;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  display: block;
  margin-bottom: 20rpx;
}
.article-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 18px;
  color: #999;
}
.meta-tag {
  background: #E8F5E9;
  color: #4CAF50;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 18px;
}
.meta-date { font-size: 18px; color: #999; }
.meta-views { font-size: 18px; color: #999; }

.article-content {
  padding: 32rpx;
  font-size: 18px;
  color: #333;
  line-height: 1.8;
}
.article-content h1 {
  font-size: 24px;
  font-weight: bold;
  margin: 32rpx 0 16rpx;
  color: #333;
}
.article-content h2 {
  font-size: 22px;
  font-weight: bold;
  margin: 28rpx 0 16rpx;
  color: #333;
}
.article-content h3 {
  font-size: 20px;
  font-weight: bold;
  margin: 24rpx 0 12rpx;
  color: #333;
}
.article-content p {
  margin-bottom: 16rpx;
  line-height: 1.8;
}
.article-content ul {
  padding-left: 40rpx;
  margin-bottom: 16rpx;
}
.article-content li {
  margin-bottom: 8rpx;
  line-height: 1.8;
}
.article-content strong {
  font-weight: bold;
  color: #333;
}

.disclaimer {
  margin: 32rpx;
  padding: 24rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
  font-size: 18px;
  color: #F57F17;
  line-height: 1.8;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 18px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-icon { font-size: 48px; }
