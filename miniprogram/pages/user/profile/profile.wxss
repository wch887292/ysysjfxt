/* pages/user/profile/profile.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.user-level {
  font-size: 18px;
  color: #FF9800;
}

/* 规范3.1 会员身份标识 */
.identity-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.identity-tag {
  font-size: 18px;
  padding: 4rpx 20rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
}

.identity-member {
  background-color: #FF9800;
  color: #ffffff;
}

.identity-user {
  background-color: #e0e0e0;
  color: #333333;
}

.member-since {
  font-size: 18px;
  color: #666666;
}

/* 规范3.2 勋章展示 */
.badges-card {
  margin-bottom: 20rpx;
}

.badges-title {
  display: block;
  font-size: 24px;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.badges-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.badge-chip {
  font-size: 18px;
  padding: 10rpx 24rpx;
  background-color: #fff3e0;
  color: #E65100;
  border-radius: 30rpx;
  border: 2rpx solid #FFB74D;
}

/* 规范3.6 分享码展示 */
.share-code-card {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

/* 管理后台入口卡片 */
.admin-entry-card {
  margin-bottom: 20rpx;
  background-color: #e8f5e9;
  border-left: 8rpx solid #4CAF50;
}

.admin-entry-list {
  margin-top: 16rpx;
}

.admin-entry-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #c8e6c9;
}

.admin-entry-item:last-child {
  border-bottom: none;
}

.share-code-label {
  font-size: 18px;
  color: #666666;
  margin-right: 16rpx;
}

.share-code-value {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  letter-spacing: 2rpx;
}

/* 适老化：菜单/按钮点击反馈 */
.menu-item-hover {
  background-color: #f5f5f5;
}

.btn-hover {
  opacity: 0.7;
}

.points-summary {
  background: linear-gradient(135deg, #FF9800 0%, #FFC107 100%);
  color: white;
  margin-bottom: 20rpx;
}

.points-item {
  text-align: center;
  padding: 30rpx;
}

.points-label {
  font-size: 18px;
  opacity: 0.9;
  display: block;
  margin-bottom: 10rpx;
}

.points-value {
  font-size: 40px;
  font-weight: bold;
}

.menu-list {
  margin-top: 10rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32px;
  margin-right: 20rpx;
}

.menu-title {
  flex: 1;
  font-size: 18px;
  color: #333;
}

.menu-arrow {
  font-size: 24px;
  color: #666666;
}

.btn-group {
  margin-top: 40rpx;
}

.btn-group button {
  margin-bottom: 32rpx;
}

/* 管理员登录弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-dialog {
  width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-title {
  display: block;
  text-align: center;
  font-size: 24px;
  font-weight: bold;
  color: #333;
  padding: 40rpx 0 20rpx;
}

.modal-body {
  padding: 20rpx 40rpx 30rpx;
}

.modal-input {
  width: 100%;
  height: 96rpx;
  font-size: 18px;
  padding: 0 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 18px;
}

.modal-btn-cancel {
  color: #666666;
  border-right: 2rpx solid #f0f0f0;
}

.modal-btn-confirm {
  color: #4CAF50;
  font-weight: bold;
}