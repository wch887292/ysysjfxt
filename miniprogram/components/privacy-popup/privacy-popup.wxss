/* components/privacy-popup/privacy-popup.wxss */
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.privacy-dialog {
  width: 100%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.privacy-header {
  padding: 40rpx 32rpx 20rpx;
  text-align: center;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.privacy-body {
  padding: 20rpx 32rpx 32rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.privacy-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.privacy-link {
  font-size: 28rpx;
  color: #4CAF50;
  text-decoration: underline;
}

.privacy-notice {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
}

.notice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.notice-item {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.privacy-footer {
  padding: 24rpx 32rpx 40rpx;
}

.btn-agree {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  margin-bottom: 20rpx;
}

.btn-agree::after {
  border: none;
}

.btn-disagree {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: transparent;
  color: #999;
  font-size: 26rpx;
  border-radius: 36rpx;
  border: none;
}

.btn-disagree::after {
  border: none;
}
