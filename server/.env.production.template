# ========================================
# 健康饮食积分系统 - 生产环境配置模板
# 安全加固版本 (2026-08-03)
# 部署时复制为 .env 并填写实际值
# ========================================

# 服务配置
PORT=3000
NODE_ENV=production
TZ=Asia/Shanghai

# 数据库配置（腾讯云 MySQL）
# Docker 模式：DB_HOST=127.0.0.1, DB_PORT=3306（容器内连接 MySQL）
# PM2 模式：DB_HOST=111.229.190.132, DB_PORT=3307（直连云服务器 MySQL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=health_system
DB_USER=root
DB_PASSWORD=wch@123456

# JWT 配置（必须使用随机强密钥，64位hex）
# 生成方法：openssl rand -hex 32
JWT_SECRET=e7f3a9c1d5b8f2e4a6c0d8b3f1e9a7c5d2b4f8e6a0c4d7b1f3e5a9c2d6b8f4e2
JWT_EXPIRES_IN=7d

# 微信小程序配置
WX_APPID=wxfe26dc17bcb16161
WX_SECRET=YOUR_WX_APP_SECRET_HERE

# AES 加密密钥（32字节hex，用于手机号加密）
# 生成方法：openssl rand -hex 32
AES_SECRET_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# AI 识别服务配置（硅基流动 SiliconFlow）
AI_SERVICE_URL=https://api.siliconflow.cn/v1/chat/completions
AI_SERVICE_KEY=YOUR_SILICONFLOW_API_KEY_HERE
AI_SERVICE_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 内容安全服务配置
CONTENT_SECURITY_URL=https://api.siliconflow.cn/v1/chat/completions
CONTENT_SECURITY_KEY=YOUR_SILICONFLOW_API_KEY_HERE
CONTENT_SECURITY_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 文本任务模型配置
TEXT_SERVICE_URL=https://api.siliconflow.cn/v1/chat/completions
TEXT_SERVICE_KEY=YOUR_SILICONFLOW_API_KEY_HERE
TEXT_SERVICE_MODEL=Qwen/Qwen3.5-4B

# CORS 配置（允许的前端域名）
ALLOWED_ORIGINS=https://rry.klai.top,https://www.rry.klai.top

# 腾讯云 COS 对象存储（可选，用于图片/文件上传）
# 如不使用，请留空或使用本地存储
OSS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
OSS_BUCKET=YOUR_BUCKET_NAME_HERE
OSS_ACCESS_KEY_ID=YOUR_COS_SECRET_ID_HERE
OSS_ACCESS_KEY_SECRET=YOUR_COS_SECRET_KEY_HERE
OSS_REGION=ap-guangzhou

# 日志配置
LOG_LEVEL=warn
LOG_FILE=logs/app.log

# 定时任务控制（多实例部署时仅主实例执行）
ENABLE_SCHEDULER=true
