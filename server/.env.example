# ============================================================
# 元生AI生态健康饮食积分系统 - 环境变量模板
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
# ============================================================

# 服务配置
PORT=3000
NODE_ENV=development

# 业务时区（必须与业务所在时区一致，否则 cron "满N天"边界会偏移）
# 部署在 UTC 时区的云服务器务必显式设置此项
TZ=Asia/Shanghai

# 数据库配置 (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=diet_points_system
DB_USER=root
DB_PASSWORD=your_real_db_password

# JWT配置
JWT_SECRET=replace_with_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# 微信小程序配置
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# 加密配置 (AES-256, 必须 32 字符)
AES_SECRET_KEY=replace_with_32_char_aes_secret_key_!!!

# AI识别/报告服务配置
AI_SERVICE_URL=https://your-ai-gateway.example.com/api
AI_SERVICE_KEY=your_ai_service_key
AI_MODEL=doubao-pro-32k

# 内容安全服务配置
CONTENT_SECURITY_URL=https://your-content-security.example.com/api
CONTENT_SECURITY_KEY=your_content_security_key

# CORS配置 (逗号分隔, 生产环境必须显式配置)
ALLOWED_ORIGINS=https://your-miniprogram-domain.com

# OSS存储配置 (可选, 本地开发可留占位)
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=diet-points-uploads
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_REGION=oss-cn-hangzhou

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log
