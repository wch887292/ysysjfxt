{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "releaseChannel": "preview"
      },
      "ios": {
        "buildType": "archive",
        "distribution": "internal",
        "releaseChannel": "preview"
      },
      "env": {
        "NODE_ENV": "production"
      }
    },
    "production": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "releaseChannel": "production",
        "image": "latest"
      },
      "ios": {
        "buildType": "archive",
        "distribution": "store",
        "releaseChannel": "production",
        "image": "latest"
      },
      "env": {
        "NODE_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "contactEmail": "admin@klai.top",
        "contactName": "快乐AI饮食",
        "contactPhone": "+86",
        "language": "ZH",
        "title": "快乐AI饮食健康积分系统",
        "description": "快乐AI饮食健康积分系统是一款基于人工智能的健康饮食管理平台，通过智能打卡、个性化食谱推荐、积分激励体系帮助用户建立健康的饮食习惯。平台结合中医食疗理论与现代营养学，为用户提供科学、实用的健康管理服务。",
        "category": "健康健美",
        "privacyPolicyUrl": "https://rry.klai.top/privacy",
        "termsOfServiceUrl": "https://rry.klai.top/terms"
      }
    }
  }
}
